<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route all requests into /public — the real Laravel front controller
    # lives there and handles the rest via public/.htaccess
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny direct access to hidden files (.env, .git, .htaccess itself, ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny direct access to project/config files at the root
<FilesMatch "(artisan|composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|vite\.config\.ts|phpunit\.xml|phpstan\.neon|pint\.json|tsconfig\.json|components\.json|\.env.*|\.git.*|\.editorconfig|\.gitattributes|\.npmrc)$">
    Require all denied
</FilesMatch>
